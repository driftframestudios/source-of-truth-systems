# Optional native PostgreSQL configuration. Copy to ignored .env and fill locally.
# The preferred Compose route generates its own .env.clone; leave that file CLI-owned.
DATABASE_PROVIDER=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Controlled local/Compose network only; remote connections default to verify-full.
PGSSLMODE=disable
# Use a separate setup owner for initialization, then select the runtime login.
# See docs/runbooks/local-postgresql-clone.md for role setup and grants.
