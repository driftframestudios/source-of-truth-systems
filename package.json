{
  "name": "source-of-truth-life-sciences",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite --host 0.0.0.0 --config vite.figma.config.ts",
    "preview": "vite preview --config vite.figma.config.ts",
    "format": "prettier --write",
    "check:3d": "node scripts/check-3d-flattening.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "node scripts/serve.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "test:mobile": "node --test tests/corridor-gesture.test.mjs",
    "test:startup": "node --test tests/startup-bundle.test.mjs",
    "dev:source": "vite --host 0.0.0.0 --config vite.figma.config.ts",
    "test:graphql": "node --test tests/graphql.test.mjs",
    "graphql:operations": "node scripts/graphql-operations.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "database:init": "node --env-file-if-exists=.env scripts/database.mjs init",
    "security:install": "node scripts/security/install-betterleaks.mjs",
    "security:scan": "node scripts/security/scan-secret-material.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:security:engine": "node --test tests/security/engine.mjs",
    "build:docs": "node scripts/documentation/build.mjs app",
    "build:foundation": "node scripts/documentation/build.mjs foundation",
    "test:mysql": "node scripts/prove-database.mjs",
    "test:browser:webkit": "playwright test --config playwright.webkit.config.mjs"
  },
  "dependencies": {
    "@graphql-yoga/plugin-persisted-operations": "4.1.0",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-table": "9.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "@whatwg-node/server": "0.13.3",
    "clsx": "2.1.1",
    "graphql": "16.15.0",
    "graphql-yoga": "6.1.0",
    "lucide-react": "0.487.0",
    "markdown-it": "15.0.3",
    "motion": "12.23.24",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "serve-handler": "6.1.8",
    "tailwind-merge": "3.2.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.3.8",
    "vite": "6.4.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "prettier": "3.10.1",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.6"
    }
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "main": "scripts/serve.mjs"
}
